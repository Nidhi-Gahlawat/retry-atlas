{
  "name": "retry-atlas",
  "version": "0.0.0",
  "description": "A decision catalog for safe retry behavior.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "bin": {
    "retry-atlas": "dist/index.js"
  },
  "files": [
    "catalog",
    "dist",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/cli/index.ts --format esm --dts --clean",
    "catalog:validate": "tsx scripts/validate-catalog.ts",
    "dev": "tsx src/cli/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "package:smoke": "tsx scripts/package-smoke.ts",
    "schema:check": "tsx scripts/generate-schema.ts --check",
    "schema:generate": "tsx scripts/generate-schema.ts",
    "site:build": "pnpm site:data && pnpm site:typecheck && vite build --config vite.site.config.ts",
    "site:data": "tsx scripts/generate-site-data.ts",
    "site:dev": "pnpm site:data && vite --config vite.site.config.ts",
    "site:preview": "vite preview --config vite.site.config.ts",
    "site:typecheck": "tsc --noEmit -p site/tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && pnpm site:typecheck"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@types/node": "^24.3.0",
    "eslint": "^10.8.1",
    "lucide": "^1.33.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^3.2.4"
  }
}
